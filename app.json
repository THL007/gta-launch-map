{
  "expo": {
    "name": "GTA Launch Map",
    "slug": "gta-launch-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gtalaunchmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trench.gtalaunchmap",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.trench.gtalaunchmap",
      "adaptiveIcon": {
        "backgroundColor": "#170C1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "GTA Launch Map",
      "shortName": "Launch Map",
      "description": "Unofficial GTA VI launch countdown: a 3D globe of midnight unlocking country by country.",
      "themeColor": "#170C1C",
      "backgroundColor": "#170C1C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#170C1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
